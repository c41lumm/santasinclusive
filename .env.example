# Neon (`neon env pull` fills these in locally; the project is in AWS Frankfurt)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Neon Auth (staff sign-in). The cookie secret is yours to make: openssl rand -base64 32
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# Public contact email (optional: defaults to elf@santasinclusivegrotto.co.uk, set in src/lib/site.ts)
NEXT_PUBLIC_CONTACT_EMAIL=

# Public site address, used in links inside messages
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Email (Resend). The Vercel integration adds RESEND_API_KEY. EMAIL_FROM must be on a domain verified in Resend,
# for example: Santa's Inclusive Grotto <hello@yourdomain.co.uk>
RESEND_API_KEY=
EMAIL_FROM=

# Texts (Twilio). TWILIO_SMS_FROM can be a sender name such as SantaGrotto, or a UK number.
# WhatsApp is switched off for now; TWILIO_WHATSAPP_FROM is only needed when it is turned back on.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=whatsapp:+44...

# Protects the scheduled jobs (Vercel sends it as a Bearer token)
CRON_SECRET=

# Local only: send real messages from npm run dev (off by default)
# SEND_IN_DEV=1
# Local only: use the admin area as this staff user_id without signing in
# DEV_STAFF_USER_ID=
