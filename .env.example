# Neon (`neon env pull` fills these in locally; the project is in AWS Frankfurt)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Neon Auth (staff sign-in). The cookie secret is yours to make: openssl rand -base64 32
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# Public contact email shown on the site (footer, privacy, groups, volunteering)
NEXT_PUBLIC_CONTACT_EMAIL=

# Public site address, used in links inside messages
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Email (SendGrid)
SENDGRID_API_KEY=
EMAIL_FROM=hello@example.com

# Texts (Twilio). TWILIO_SMS_FROM can be a sender name such as SantaGrotto, or a UK number.
# WhatsApp is switched off for now; TWILIO_WHATSAPP_FROM is only needed when it is turned back on.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=whatsapp:+44...

# Protects the scheduled jobs (Vercel sends it as a Bearer token)
CRON_SECRET=
