# Neon (`neon env pull` fills these in locally; the project is in AWS Frankfurt)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Neon Auth (staff sign-in). The cookie secret is yours to make: openssl rand -base64 32
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# Public site address, used in links inside messages
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Bot check on the booking form (Cloudflare Turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Email (SendGrid)
SENDGRID_API_KEY=
EMAIL_FROM=hello@example.com

# Text and WhatsApp (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=whatsapp:+44...

# Protects the scheduled jobs (Vercel sends it as a Bearer token)
CRON_SECRET=
